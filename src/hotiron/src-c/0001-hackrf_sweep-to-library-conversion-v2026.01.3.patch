From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: chris-piekarski <chris-piekarski@users.noreply.github.com>
Date: Tue, 18 Aug 2026 00:00:00 +0000
Subject: [PATCH] hackrf_sweep to library conversion v2026.01.3

Rebased from the v2024.02.1 library-mode patch onto GSG v2026.01.3.
Adds serial/CLKOUT configuration and host-side linear-power averaging for
configurable 8192-sample hardware dwell blocks.

---
diff --git a/host/hackrf-tools/src/hackrf_sweep.c b/host/hackrf-tools/src/hackrf_sweep.c
index 38efa223..8bccbe6b 100644
--- a/host/hackrf-tools/src/hackrf_sweep.c
+++ b/host/hackrf-tools/src/hackrf_sweep.c
@@ -20,7 +20,7 @@
  * the Free Software Foundation, Inc., 51 Franklin Street,
  * Boston, MA 02110-1301, USA.
  */
-
+#define HACKRF_SWEEP_AS_LIBRARY
 #include <hackrf.h>
 
 #include <stdbool.h>
@@ -37,6 +37,12 @@
 #include <fftw3.h>
 #include <inttypes.h>
 
+#ifdef HACKRF_SWEEP_AS_LIBRARY
+	#include <libusb.h>
+	#include "../../../../../src-c/hackrf_sweep.h"
+	#include "../../../../../src-c/sweep_power_average.h"
+#endif
+
 #define _FILE_OFFSET_BITS 64
 
 #ifdef _WIN32
@@ -96,6 +102,7 @@ int gettimeofday(struct timeval* tv, void* ignored)
 #define OFFSET    7500000
 
 #define BLOCKS_PER_TRANSFER 16
+#define MAX_FFT_BINS        8180
 
 #if defined _WIN32
 	#define m_sleep(a) Sleep((a))
@@ -197,15 +204,28 @@ fftwf_plan ifftwPlan = NULL;
 uint32_t ifft_idx = 0;
 float* pwr;
 float* window;
+static sweep_power_average power_average;
+static double power_sums[MAX_FFT_BINS];
 
 struct timeval usb_transfer_time;
 
-float logPower(fftwf_complex in, float scale)
+#ifdef HACKRF_SWEEP_AS_LIBRARY
+static void (*fft_power_callback)(
+	char /*full_sweep_done*/,
+	int /*bins*/,
+	double* /*freqStart*/,
+	float /*fft_bin_Hz*/,
+	float* /*powerdBm*/);
+static double* binsFreqStart = NULL;
+static float* binsPowerdBm = NULL;
+static int binsMaxEntries = 0;
+#endif
+
+float linearPower(fftwf_complex in, float scale)
 {
 	float re = in[0] * scale;
 	float im = in[1] * scale;
-	float magsq = re * re + im * im;
-	return (float) (log2(magsq) * 10.0f / log2(10.0f));
+	return re * re + im * im;
 }
 
 int rx_callback(hackrf_transfer* transfer)
@@ -219,6 +239,12 @@ int rx_callback(hackrf_transfer* transfer)
 	struct tm* fft_time;
 	char time_str[50];
 
+#ifdef HACKRF_SWEEP_AS_LIBRARY
+	int binsLength = 0;
+	bool fullSweepDone = false;
+	bool stopProcessing = false;
+#endif
+
 	if (NULL == outfile) {
 		return -1;
 	}
@@ -251,7 +276,21 @@ int rx_callback(hackrf_transfer* transfer)
 			buf += BYTES_PER_BLOCK;
 			continue;
 		}
-		if (frequency == (uint64_t) (FREQ_ONE_MHZ * frequencies[0])) {
+		if (sweep_power_average_begin_frequency(&power_average, frequency) &&
+		    frequency == (uint64_t) (FREQ_ONE_MHZ * frequencies[0])) {
+#ifdef HACKRF_SWEEP_AS_LIBRARY
+			fullSweepDone = true;
+			// flush previous data so that it can be displayed
+			fft_power_callback(
+				fullSweepDone,
+				binsLength,
+				binsFreqStart,
+				fft_bin_width,
+				binsPowerdBm);
+			binsLength = 0;
+			fullSweepDone = false;
+#endif
+
 			if (sweep_started) {
 				if (ifft_output) {
 					fftwf_execute(ifftwPlan);
@@ -303,9 +350,49 @@ int rx_callback(hackrf_transfer* transfer)
 		buf += num_fft_bins * 2;
 		fftwf_execute(fftwPlan);
 		for (i = 0; i < num_fft_bins; i++) {
-			pwr[i] = logPower(fftwOut[i], 1.0f / num_fft_bins);
+			pwr[i] = linearPower(fftwOut[i], 1.0f / num_fft_bins);
+		}
+		if (!sweep_power_average_push(&power_average, pwr, pwr)) {
+			continue;
 		}
 		if (binary_output) {
+#ifdef HACKRF_SWEEP_AS_LIBRARY
+			if (!stopProcessing) {
+				for (i = 0; i < num_fft_bins / 4; ++i) {
+					if (binsLength >= binsMaxEntries) {
+						fprintf(stderr,
+							"binsLength %d > binsMaxEntries %d\n",
+							binsLength,
+							binsMaxEntries);
+						stopProcessing = true;
+						break;
+					}
+					binsFreqStart[binsLength] =
+						frequency + i * (double) fft_bin_width;
+					binsPowerdBm[binsLength] =
+						pwr[1 + (num_fft_bins * 5) / 8 + i];
+					binsLength++;
+				}
+			}
+			if (!stopProcessing) {
+				for (i = 0; i < num_fft_bins / 4; ++i) {
+					if (binsLength >= binsMaxEntries) {
+						fprintf(stderr,
+							"binsLength %d > binsMaxEntries %d\n",
+							binsLength,
+							binsMaxEntries);
+						stopProcessing = true;
+						break;
+					}
+					binsFreqStart[binsLength] = frequency +
+						DEFAULT_SAMPLE_RATE_HZ / 2 +
+						i * (double) fft_bin_width;
+					binsPowerdBm[binsLength] =
+						pwr[1 + num_fft_bins / 8 + i];
+					binsLength++;
+				}
+			}
+#else
 			record_length = 2 * sizeof(band_edge) +
 				(num_fft_bins / 4) * sizeof(float);
 
@@ -328,6 +415,7 @@ int rx_callback(hackrf_transfer* transfer)
 			       sizeof(float),
 			       num_fft_bins / 4,
 			       outfile);
+#endif
 		} else if (ifft_output) {
 			ifft_idx = (uint32_t) round(
 				(frequency - (uint64_t) (FREQ_ONE_MHZ * frequencies[0])) /
@@ -381,6 +469,18 @@ int rx_callback(hackrf_transfer* transfer)
 			fprintf(outfile, "\n");
 		}
 	}
+
+#ifdef HACKRF_SWEEP_AS_LIBRARY
+	if (binsLength > 0) {
+		fft_power_callback(
+			fullSweepDone,
+			binsLength,
+			binsFreqStart,
+			fft_bin_width,
+			binsPowerdBm);
+	}
+#endif
+
 	return 0;
 }
 
@@ -459,7 +559,50 @@ int export_wisdom(const char* path)
 	return 1;
 }
 
+#ifdef HACKRF_SWEEP_AS_LIBRARY
+
+static char lib_serial[64];
+static const char* lib_serial_ptr = NULL;
+static unsigned int lib_clkout = 0;
+
+void hackrf_sweep_lib_stop()
+{
+	do_exit = true;
+}
+
+void hackrf_sweep_lib_config(const char* serial_number, unsigned int clkout_enable)
+{
+	if (serial_number == NULL || serial_number[0] == '\0') {
+		lib_serial[0] = '\0';
+		lib_serial_ptr = NULL;
+	} else {
+		snprintf(lib_serial, sizeof(lib_serial), "%s", serial_number);
+		lib_serial_ptr = lib_serial;
+	}
+	lib_clkout = clkout_enable ? 1 : 0;
+}
+
+/**
+ * for parameters, enter 0 for default values
+ */
+int hackrf_sweep_lib_start(
+	void (*_fft_power_callback)(
+		char /*full_sweep_done*/,
+		int /*bins*/,
+		double* /*freqStart*/,
+		float /*fft_bin_Hz*/,
+		float* /*powerdBm*/),
+	uint32_t freq_min,
+	uint32_t freq_max,
+	uint32_t _fft_bin_width,
+	uint32_t num_samples,
+	unsigned int lna_gain,
+	unsigned int vga_gain,
+	unsigned int _antennaPowerEnable,
+	unsigned int _enableAntennaLNA)
+#else
 int main(int argc, char** argv)
+#endif
 {
 	int opt, i, result = 0;
 	const char* path = NULL;
@@ -469,13 +605,74 @@ int main(int argc, char** argv)
 	struct timeval time_prev;
 	float time_diff;
 	float sweep_rate = 0;
+#ifndef HACKRF_SWEEP_AS_LIBRARY
 	unsigned int lna_gain = 16, vga_gain = 20;
 	uint32_t freq_min = 0;
 	uint32_t freq_max = 6000;
+#endif
 	uint32_t requested_fft_bin_width;
+#ifdef HACKRF_SWEEP_AS_LIBRARY
+	uint32_t sweep_num_bytes;
+#endif
 	const char* fftwWisdomPath = NULL;
 	int fftw_plan_type = FFTW_MEASURE;
 
+#ifdef HACKRF_SWEEP_AS_LIBRARY
+	do_exit = false;
+	sweep_started = false;
+	sweep_count = 0;
+	byte_count = 0;
+	setbuf(stderr, NULL);
+	binary_output = true;
+	fft_bin_width = _fft_bin_width;
+	num_ranges = 0;
+	serial_number = lib_serial_ptr;
+
+	if (freq_min >= freq_max) {
+		fprintf(stderr,
+			"argument error: freq_max must be greater than freq_min.\n");
+		return EXIT_FAILURE;
+	}
+	if (FREQ_MAX_MHZ < freq_max) {
+		fprintf(stderr,
+			"argument error: freq_max may not be higher than %u.\n",
+			FREQ_MAX_MHZ);
+		return EXIT_FAILURE;
+	}
+	if (MAX_SWEEP_RANGES <= num_ranges) {
+		fprintf(stderr,
+			"argument error: specify a maximum of %u frequency ranges.\n",
+			MAX_SWEEP_RANGES);
+		return EXIT_FAILURE;
+	}
+	frequencies[2 * num_ranges] = (uint16_t) freq_min;
+	frequencies[2 * num_ranges + 1] = (uint16_t) freq_max;
+	num_ranges++;
+
+	num_samples = num_samples == 0 ? SAMPLES_PER_BLOCK : num_samples;
+	if (!sweep_samples_to_bytes(
+		    num_samples,
+		    SAMPLES_PER_BLOCK,
+		    &sweep_num_bytes)) {
+		fprintf(stderr,
+			"argument error: num_samples must be a multiple of %u.\n",
+			SAMPLES_PER_BLOCK);
+		return EXIT_FAILURE;
+	}
+	num_fft_bins = DEFAULT_SAMPLE_RATE_HZ / fft_bin_width;
+
+	if (_fft_power_callback == NULL) {
+		fprintf(stderr, "argument error: callback function pointer NULL\n");
+		return EXIT_FAILURE;
+	}
+	fft_power_callback = _fft_power_callback;
+
+	antenna = true;
+	antenna_enable = !!_antennaPowerEnable;
+	amp = true;
+	amp_enable = !!_enableAntennaLNA;
+
+#else
 	while ((opt = getopt(argc, argv, "a:f:p:l:g:d:N:w:W:P:n1BIr:h?")) != EOF) {
 		result = HACKRF_SUCCESS;
 		switch (opt) {
@@ -599,6 +801,7 @@ int main(int argc, char** argv)
 			return EXIT_FAILURE;
 		}
 	}
+#endif
 
 	// Try to load a wisdom file if specified, otherwise
 	// try to load the system-wide wisdom file
@@ -670,7 +868,7 @@ int main(int argc, char** argv)
 	 * makes our maximum supported num_fft_bins 8180.  With our fixed sample
 	 * rate of 20 Msps, that results in a minimum bin width of 2445 Hz.
 	 */
-	if (8180 < num_fft_bins) {
+	if (MAX_FFT_BINS < num_fft_bins) {
 		fprintf(stderr,
 			"argument error: FFT bin width (-w) must be no less than 2445\n");
 		return EXIT_FAILURE;
@@ -695,6 +893,17 @@ int main(int argc, char** argv)
 		fftw_plan_type);
 	pwr = (float*) fftwf_malloc(sizeof(float) * num_fft_bins);
 	window = (float*) fftwf_malloc(sizeof(float) * num_fft_bins);
+	sweep_power_average_destroy(&power_average);
+	if (!sweep_power_average_init(
+		    &power_average,
+		    num_fft_bins,
+		    num_samples,
+		    SAMPLES_PER_BLOCK,
+		    power_sums,
+		    MAX_FFT_BINS)) {
+		fprintf(stderr, "cannot initialize sweep power average\n");
+		return EXIT_FAILURE;
+	}
 	for (i = 0; i < num_fft_bins; i++) {
 		window[i] =
 			(float) (0.5f * (1.0f - cos(2 * M_PI * i / (num_fft_bins - 1))));
@@ -714,6 +928,52 @@ int main(int argc, char** argv)
 	}
 #endif
 
+#ifdef HACKRF_SWEEP_AS_LIBRARY
+	binsMaxEntries = num_fft_bins / 4 * 2 * BLOCKS_PER_TRANSFER;
+	binsFreqStart = malloc(sizeof(*binsFreqStart) * binsMaxEntries);
+	binsPowerdBm = malloc(sizeof(*binsPowerdBm) * binsMaxEntries);
+	if (!binsFreqStart || !binsPowerdBm) {
+		if (binsFreqStart)
+			free(binsFreqStart);
+		if (binsPowerdBm)
+			free(binsPowerdBm);
+
+		fprintf(stderr, "cannot allocate memory\n");
+		return EXIT_FAILURE;
+	}
+
+	if (1) {
+		// Reset device before using it to prevent stuck hardware
+		if (libusb_init(NULL) != 0) {
+			fprintf(stderr, "cannot init libusb\n");
+			return EXIT_FAILURE;
+		}
+		uint16_t hackrf_usb_vid = 0x1d50;
+		uint16_t hackrf_one_usb_pid = 0x6089;
+		struct libusb_device_handle* usb_device = libusb_open_device_with_vid_pid(
+			NULL,
+			hackrf_usb_vid,
+			hackrf_one_usb_pid);
+		if (usb_device) {
+			libusb_reset_device(usb_device);
+			libusb_close(usb_device);
+
+			int timeout = 100;
+			while (timeout-- > 0) {
+				usb_device = libusb_open_device_with_vid_pid(
+					NULL,
+					hackrf_usb_vid,
+					hackrf_one_usb_pid);
+				if (usb_device != NULL) {
+					libusb_close(usb_device);
+					break;
+				}
+				usleep(10000);
+			}
+		}
+	}
+#endif
+
 	result = hackrf_init();
 	if (result != HACKRF_SUCCESS) {
 		fprintf(stderr,
@@ -734,6 +994,18 @@ int main(int argc, char** argv)
 		return EXIT_FAILURE;
 	}
 
+#ifdef HACKRF_SWEEP_AS_LIBRARY
+	if (lib_clkout) {
+		result = hackrf_set_clkout_enable(device, 1);
+		if (result != HACKRF_SUCCESS) {
+			fprintf(stderr,
+				"hackrf_set_clkout_enable() failed: %s (%d)\n",
+				hackrf_error_name(result),
+				result);
+		}
+	}
+#endif
+
 	if ((NULL == path) || (strcmp(path, "-") == 0)) {
 		outfile = stdout;
 	} else {
@@ -752,16 +1024,20 @@ int main(int argc, char** argv)
 		return EXIT_FAILURE;
 	}
 
-#ifdef _MSC_VER
+#ifndef HACKRF_SWEEP_AS_LIBRARY
+
+	#ifdef _MSC_VER
 	SetConsoleCtrlHandler((PHANDLER_ROUTINE) sighandler, TRUE);
-#else
+	#else
 	signal(SIGINT, &sigint_callback_handler);
 	signal(SIGILL, &sigint_callback_handler);
 	signal(SIGFPE, &sigint_callback_handler);
 	signal(SIGSEGV, &sigint_callback_handler);
 	signal(SIGTERM, &sigint_callback_handler);
 	signal(SIGABRT, &sigint_callback_handler);
+	#endif
 #endif
+
 	fprintf(stderr,
 		"call hackrf_sample_rate_set(%.03f MHz)\n",
 		((float) DEFAULT_SAMPLE_RATE_HZ / (float) FREQ_ONE_MHZ));
@@ -831,7 +1107,7 @@ int main(int argc, char** argv)
 		device,
 		frequencies,
 		num_ranges,
-		BYTES_PER_BLOCK,
+		sweep_num_bytes,
 		TUNE_STEP * FREQ_ONE_MHZ,
 		OFFSET,
 		INTERLEAVED);
@@ -885,7 +1161,18 @@ int main(int argc, char** argv)
 	fprintf(stderr, "Stop with Ctrl-C\n");
 	while ((hackrf_is_streaming(device) == HACKRF_TRUE) && (do_exit == false)) {
 		float time_difference;
+
+#ifndef HACKRF_SWEEP_AS_LIBRARY
 		m_sleep(50);
+#else
+		// allows fast shutdown
+		int limit = 20 * 10;
+		while (do_exit == false && limit-- > 0) {
+			usleep(10000);
+		}
+		if (do_exit)
+			break;
+#endif
 
 		gettimeofday(&time_now, NULL);
 		if (TimevalDiff(&time_now, &time_prev) >= 1.0f) {
@@ -947,17 +1234,28 @@ int main(int argc, char** argv)
 
 	fflush(outfile);
 	if ((outfile != NULL) && (outfile != stdout)) {
+#ifndef HACKRF_SWEEP_AS_LIBRARY
 		fclose(outfile);
+#endif
 		outfile = NULL;
 		fprintf(stderr, "fclose() done\n");
 	}
 	fftwf_free(fftwIn);
 	fftwf_free(fftwOut);
 	fftwf_free(pwr);
 	fftwf_free(window);
 	fftwf_free(ifftwIn);
 	fftwf_free(ifftwOut);
+	sweep_power_average_destroy(&power_average);
 	export_wisdom(fftwWisdomPath);
+
+#ifdef HACKRF_SWEEP_AS_LIBRARY
+	if (binsFreqStart)
+		free(binsFreqStart);
+	if (binsPowerdBm)
+		free(binsPowerdBm);
+#endif
+
 	fprintf(stderr, "exit\n");
 	return exit_code;
 }
